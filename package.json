{
  "name": "evp-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:client --",
    "build:client": "pwsh -NoProfile -File tools/build-client.ps1",
    "build:server": "node tools/build-server-image.mjs",
    "build:server:push": "node tools/build-server-image.mjs --push",
    "signal": "node server/main.mjs",
    "desktop": "node desktop/main.mjs",
    "test": "node --test \"test/*.mjs\"",
    "test:session": "node tools/session-smoke.mjs"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "playwright-core": "1.65.1"
  }
}
